# --- DB ---
DB_URL=jdbc:mysql://localhost:3306/schwab_trading?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASS=change-me

# --- App ---
APP_BASE_URL=http://localhost:8080

# --- Schwab OAuth2 ---
SCHWAB_CLIENT_ID=change-me
SCHWAB_CLIENT_SECRET=change-me
SCHWAB_SCOPES=change-me
SCHWAB_REDIRECT_URI=https://myschwab.xsbngroup.com:8080/oauth/callback

SCHWAB_AUTH_URL=change-me
SCHWAB_TOKEN_URL=change-me
SCHWAB_API_BASE_URL=change-me

# --- Polling ---
APP_POLL_ORDERS_MS=5000
APP_REFRESH_DEFAULT_ACCOUNT_MS=30000
APP_SNAPSHOT_TTL_MS=300000

# --- SSL (optional) ---
# Enable HTTPS directly in the app (useful when Schwab redirect URIs require https).
# Put your keystore in ./config (git-ignored) and point SERVER_SSL_KEY_STORE at it.
SERVER_SSL_ENABLED=false
SERVER_SSL_KEY_STORE=file:config/keystore.p12
SERVER_SSL_KEY_STORE_PASSWORD=change-me
SERVER_SSL_KEY_STORE_TYPE=PKCS12
SERVER_SSL_KEY_ALIAS=change-me
SERVER_SSL_KEY_PASSWORD=change-me
